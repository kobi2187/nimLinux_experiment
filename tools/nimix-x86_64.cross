# SPDX-License-Identifier: GPL-2.0
# Meson cross file: picolibc for NimixOS userspace (freestanding x86-64).
# Same code-generation flags as the apps (Makefile NIM_APP): PIC so the loader can
# place images anywhere, no red zone (interrupts use the user stack), frame
# pointers for the crash backtrace, SSE2 math, no stack protector (no TLS/canary).
[binaries]
c = ['gcc', '-ffreestanding', '-fPIC', '-mno-red-zone', '-fno-stack-protector', '-fno-omit-frame-pointer', '-mfpmath=sse', '-msse2', '-nostdlib', '-static']
ar = 'ar'
as = 'as'
nm = 'nm'
strip = 'strip'
objcopy = 'objcopy'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
skip_sanity_check = true
needs_exe_wrapper = true
link_spec = '--build-id=none'
default_flash_addr = '0x00100000'
default_flash_size = '0x00400000'
default_ram_addr   = '0x00500000'
default_ram_size   = '0x00200000'
