@@ -0,0 +1,11 @@
+## The text engine behind `pango_text`, chosen at compile time:
+##   default           Pango + Cairo (system libraries)
+##   -d:ruiTextPixie   Pixie (pure Nim; no system libraries; NimixOS)
+## Both export the same `engine*` procs (see text_engine_pango.nim).
+
+when defined(ruiTextPixie):
+  import text_engine_pixie
+  export text_engine_pixie
+else:
+  import text_engine_pango
+  export text_engine_pango
