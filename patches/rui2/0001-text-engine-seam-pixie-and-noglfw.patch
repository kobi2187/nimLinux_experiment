@@ -0,0 +1,238 @@
+## Text engine: Pango + Cairo (the default; needs the system libraries).
+## =====================================================================
+##
+## Lays text out and rasterises it with Pango/PangoCairo. `pango_text` holds
+## the public API and the caches; the alternative engine is
+## `text_engine_pixie` (pure Nim, `-d:ruiTextPixie`). Both export the same
+## `engine*` procs.
+
+import std/options
+import raylib
+import pango_binding
+import text_types
+
+var
+  measureSurface: CairoSurface
+  measureCtx: CairoContext
+  renderOptions = FontRenderOptions(
+    antialias: CairoAntialiasGray,
+    hintStyle: CairoHintSlight,
+    subpixelOrder: CairoSubpixelDefault
+  )
+
+proc engineSetRenderOptions*(opts: FontRenderOptions) =
+  renderOptions = opts
+
+proc engineRenderOptions*(): FontRenderOptions = renderOptions
+
+proc ensureMeasureCtx() =
+  if measureCtx.pointer.isNil:
+    measureSurface = cairoImageSurfaceCreate(CairoFormatA8, 1, 1)
+    measureCtx = cairoCreate(measureSurface)
+
+proc applyFontOptions(layout: PangoLayout) =
+  let opts = cairoFontOptionsCreate()
+  cairoFontOptionsSetAntialias(opts, renderOptions.antialias)
+  cairoFontOptionsSetHintStyle(opts, renderOptions.hintStyle)
+  cairoFontOptionsSetSubpixelOrder(opts, renderOptions.subpixelOrder)
+  pangoCairoContextSetFontOptions(pangoLayoutGetContext(layout), opts)
+  cairoFontOptionsDestroy(opts)
+  pangoLayoutContextChanged(layout)
+
+template withLayoutDir(font: string, wrapWidth: int32, markup: bool,
+                       ctx: CairoContext, content: string, dir: TextDir,
+                       body: untyped) =
+  ## Build a configured PangoLayout named `layout`, run `body`, then free it.
+  var layout {.inject.} = pangoCairoCreateLayout(ctx)
+  applyFontOptions(layout)
+
+  let desc = pangoFontDescriptionFromString(font.cstring)
+  pangoLayoutSetFontDescription(layout, desc)
+  pangoFontDescriptionFree(desc)
+
+  # Let Pango pick the base direction from the text itself, so a Hebrew or
+  # Arabic string lays out right-to-left without the caller saying so --
+  # unless the caller knows better (a wrapped line keeps its paragraph's).
+  if dir == tdAuto:
+    pangoLayoutSetAutoDir(layout, 1)
+  else:
+    pangoLayoutSetAutoDir(layout, 0)
+    pangoContextSetBaseDir(pangoLayoutGetContext(layout),
+                           (if dir == tdRtl: 1.cint else: 0.cint))
+    pangoLayoutContextChanged(layout)
+
+  if wrapWidth > 0:
+    pangoLayoutSetWidth(layout, wrapWidth * PANGO_SCALE)
+    pangoLayoutSetWrap(layout, PangoWrapWordChar)
+  else:
+    pangoLayoutSetWidth(layout, -1)
+    pangoLayoutSetSingleParagraphMode(layout, 1)
+
+  if markup:
+    pangoLayoutSetMarkup(layout, content.cstring, content.len.cint)
+  else:
+    pangoLayoutSetText(layout, content.cstring, content.len.cint)
+
+  body
+  gObjectUnref(layout.pointer)
+
+template withLayout(font: string, wrapWidth: int32, markup: bool,
+                    ctx: CairoContext, content: string, body: untyped) =
+  withLayoutDir(font, wrapWidth, markup, ctx, content, tdAuto, body)
+
+
+proc engineMeasure*(text: string, font: string, wrapWidth: int32 = -1,
+                     markup = false, dir = tdAuto): TextMeasure =
+  ## Real text metrics from the layout engine.
+  ensureMeasureCtx()
+
+  # An empty string still occupies a line, so measure a space to get the font's
+  # line height: empty labels and inputs keep their row height.
+  let content = if text.len == 0: " " else: text
+  withLayoutDir(font, wrapWidth, markup and text.len > 0, measureCtx, content, dir):
+    var w, h: cint
+    pangoLayoutGetPixelSize(layout, addr w, addr h)
+    result = TextMeasure(
+      width: (if text.len == 0: 0.0'f32 else: w.float32),
+      height: h.float32,
+      baseline: toPixels(pangoLayoutGetBaseline(layout)),
+      lineCount: pangoLayoutGetLineCount(layout).int
+    )
+
+
+const
+  LogAttrCursorPosition = 1'u32 shl 4
+  LogAttrWordStart = 1'u32 shl 5
+  LogAttrWordEnd = 1'u32 shl 6
+  LogAttrBackspaceChar = 1'u32 shl 10
+
+proc engineClusterAttrs*(text: string; attrs: var CharAttrs) =
+  ## Fill cursorStop/backspaceChar/wordStart/wordEnd (byteAt already set):
+  ## Pango knows the Unicode rules (UAX #29) and the per-script exceptions.
+  ensureMeasureCtx()
+  withLayout("Sans 12", -1, false, measureCtx, text):
+    var n: cint
+    let logAttrs = cast[ptr UncheckedArray[uint32]](
+      pangoLayoutGetLogAttrsReadonly(layout, addr n))
+    for k in 0 ..< min(int(n), attrs.byteAt.len):
+      attrs.cursorStop[k] = (logAttrs[k] and LogAttrCursorPosition) != 0
+      attrs.backspaceChar[k] = (logAttrs[k] and LogAttrBackspaceChar) != 0
+      attrs.wordStart[k] = (logAttrs[k] and LogAttrWordStart) != 0
+      attrs.wordEnd[k] = (logAttrs[k] and LogAttrWordEnd) != 0
+
+proc engineMoveCaretVisually*(text: string, index: int, direction: int): Option[int] =
+  ensureMeasureCtx()
+  withLayout("Sans 12", -1, false, measureCtx, text):
+    var newIndex, newTrailing: cint
+    pangoLayoutMoveCursorVisually(layout, 1, index.cint, 0, direction.cint,
+                                  addr newIndex, addr newTrailing)
+    if newIndex < 0 or newIndex > text.len:
+      return none(int)
+    var pos = int(newIndex)
+    for _ in 0 ..< int(newTrailing):          # trailing = characters past the index
+      inc pos
+      while pos < text.len and (ord(text[pos]) and 0xC0) == 0x80: inc pos
+    return some(pos)
+
+proc engineSoftBreaks*(text, font: string, wrapWidth: int32): seq[int] =
+  result = @[0]
+  ensureMeasureCtx()
+  withLayout(font, wrapWidth, false, measureCtx, text):
+    let n = pangoLayoutGetLineCount(layout)
+    for i in 1 ..< n:
+      let line = pangoLayoutGetLineReadonly(layout, i)
+      if line != nil:
+        result.add int(line.start_index)
+
+proc engineCursorPosition*(text, font: string, byteIndex: int,
+                           wrapWidth: int32, dir: TextDir): CursorPos =
+  ensureMeasureCtx()
+  withLayoutDir(font, wrapWidth, false, measureCtx, text, dir):
+    var strong, weak: PangoRectangle
+    pangoLayoutGetCursorPos(layout, byteIndex.cint, addr strong, addr weak)
+    result = CursorPos(x: toPixels(strong.x), y: toPixels(strong.y),
+                       height: toPixels(strong.height))
+
+proc engineIndexFromPosition*(text, font: string, x, y: float32,
+                              wrapWidth: int32, dir: TextDir): HitResult =
+  ensureMeasureCtx()
+  withLayoutDir(font, wrapWidth, false, measureCtx, text, dir):
+    var index, trailing: cint
+    let inside = pangoLayoutXyToIndex(layout, toPangoUnits(x), toPangoUnits(y),
+                                      addr index, addr trailing)
+    result = HitResult(index: index.int, trailing: trailing.int,
+                       inside: inside != 0)
+
+proc engineParagraphDir*(text: string): TextDir =
+  if text.len == 0: tdLtr
+  elif pangoFindBaseDir(text.cstring, text.len.cint) == 1: tdRtl
+  else: tdLtr
+
+proc engineRasteriseA8*(text, font: string, wrapWidth: int32,
+                 m: TextMeasure, dir = tdAuto): seq[Color] =
+  ## Coverage mask -> white RGBA. Colour comes from the draw tint.
+  let w = max(1'i32, m.width.int32)
+  let h = max(1'i32, m.height.int32)
+
+  let surface = cairoImageSurfaceCreate(CairoFormatA8, w, h)
+  let ctx = cairoCreate(surface)
+  cairoSetSourceRgba(ctx, 1.0, 1.0, 1.0, 1.0)
+
+  withLayoutDir(font, wrapWidth, false, ctx, text, dir):
+    cairoMoveTo(ctx, 0.0, 0.0)
+    pangoCairoShowLayout(ctx, layout)
+
+  cairoSurfaceFlush(surface)
+  let stride = cairoImageSurfaceGetStride(surface)
+  let data = cairoImageSurfaceGetData(surface)
+
+  result = newSeq[Color](w * h)
+  if not data.isNil:
+    for y in 0 ..< h:
+      let row = y * stride
+      for x in 0 ..< w:
+        result[y * w + x] = Color(r: 255, g: 255, b: 255, a: data[row + x])
+
+  cairoDestroy(ctx)
+  cairoSurfaceDestroy(surface)
+
+proc engineRasteriseArgb32*(markupText, font: string, wrapWidth: int32,
+                     m: TextMeasure): seq[Color] =
+  ## Full-colour path, for Pango markup with per-run colours
+  ## (`<span foreground='red'>`). Draw this with a White tint.
+  let w = max(1'i32, m.width.int32)
+  let h = max(1'i32, m.height.int32)
+
+  let surface = cairoImageSurfaceCreate(CairoFormatArgb32, w, h)
+  let ctx = cairoCreate(surface)
+  cairoSetSourceRgba(ctx, 0.0, 0.0, 0.0, 1.0)
+
+  withLayout(font, wrapWidth, true, ctx, markupText):
+    cairoMoveTo(ctx, 0.0, 0.0)
+    pangoCairoShowLayout(ctx, layout)
+
+  cairoSurfaceFlush(surface)
+  let stride = cairoImageSurfaceGetStride(surface)
+  let data = cairoImageSurfaceGetData(surface)
+
+  result = newSeq[Color](w * h)
+  if not data.isNil:
+    for y in 0 ..< h:
+      var src = y * stride
+      for x in 0 ..< w:
+        # Cairo ARGB32 on a little-endian host is B,G,R,A and *premultiplied*.
+        # Undo the premultiplication, or every antialiased edge comes out dark.
+        let a = data[src + 3]
+        var r = data[src + 2]
+        var g = data[src + 1]
+        var b = data[src + 0]
+        if a != 0 and a != 255:
+          r = uint8(min(255, r.int * 255 div a.int))
+          g = uint8(min(255, g.int * 255 div a.int))
+          b = uint8(min(255, b.int * 255 div a.int))
+        result[y * w + x] = Color(r: r, g: g, b: b, a: a)
+        src += 4
+
+  cairoDestroy(ctx)
+  cairoSurfaceDestroy(surface)
+
diff --git a/packages/rui_drawing/src/text_engine_pixie.nim b/packages/rui_drawing/src/text_engine_pixie.nim
new file mode 100644
index 0000000..054ea75
--- /dev/null
+++ b/packages/rui_drawing/src/text_engine_pixie.nim
@@ -0,0 +1,311 @@
+## Text engine: Pixie (pure Nim; `-d:ruiTextPixie`).
+## ==================================================
+##
+## The same `engine*` procs as `text_engine_pango`, built on Pixie's font
+## parsing, typesetting (`typeset` -> `Arrangement`) and rasterisation. No
+## system libraries: it runs where Pango cannot (NimixOS, WASM hosts,
+## minimal desktops).
+##
+## Differences from Pango, by design of what Pixie provides:
+## - Latin/Cyrillic/Greek/CJK lay out left to right with kerning; there is no
+##   complex shaping (no GSUB ligatures) and no bidi reordering: RTL text is
+##   laid out logically. `paragraphDir` still reports the paragraph's direction.
+## - Cluster and word rules are an approximation of UAX #29 (combining marks,
+##   ZWJ sequences, variation selectors, emoji modifiers, regional-indicator
+##   pairs), not Pango's per-script tables.
+## - Render options (hinting, subpixel order) are accepted and ignored.
+##
+## Fonts: a Pango-style description ("DejaVu Sans Bold 12": family, styles,
+## size in points) picks a registered face. `registerFontFile` /
+## `registerFontData` add faces; with none registered, the first match of
+## `RUI_FONT_FILE` or a few common system fonts becomes "Sans".
+
+import std/[options, os, strutils, tables, unicode]
+import pixie
+import raylib
+import text_types
+
+type
+  FaceKey = object
+    family: string        ## lower case
+    bold, italic: bool
+
+  FontSpec = object
+    face: Typeface
+    px: float32           ## pixel size (points at 96 dpi, as Cairo renders)
+
+var
+  faces: Table[FaceKey, Typeface]
+  renderOptions: FontRenderOptions
+  defaultsLoaded = false
+
+const SystemFonts = [
+  "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+  "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+  "/usr/share/fonts/truetype/crosextra/Carlito-Regular.ttf",
+  "/usr/share/fonts/TTF/DejaVuSans.ttf"]
+
+proc engineSetRenderOptions*(opts: FontRenderOptions) = renderOptions = opts
+proc engineRenderOptions*(): FontRenderOptions = renderOptions
+
+proc registerFontData*(family: string; bold, italic: bool; data: string) =
+  ## Add a face from TTF/OTF bytes (NimixOS: a sealed shared font buffer).
+  faces[FaceKey(family: family.toLowerAscii, bold: bold, italic: italic)] =
+    parseOtf(data)
+
+proc registerFontFile*(family: string; bold, italic: bool; path: string) =
+  faces[FaceKey(family: family.toLowerAscii, bold: bold, italic: italic)] =
+    readTypeface(path)
+
+proc loadDefaults() =
+  ## First use with nothing registered: find one regular face for "sans".
+  defaultsLoaded = true
+  if faces.len > 0: return
+  var candidates = @[getEnv("RUI_FONT_FILE")]
+  candidates.add SystemFonts
+  for path in candidates:
+    if path.len > 0 and fileExists(path):
+      registerFontFile("sans", false, false, path)
+      return
+
+proc parseDesc(desc: string): (FaceKey, float32) =
+  ## "DejaVu Sans Bold Italic 12.0" -> family, styles, size in points.
+  var key: FaceKey
+  var size = 12'f32
+  var family: seq[string]
+  for tok in strutils.splitWhitespace(desc):
+    let t = tok.toLowerAscii
+    if t == "bold" or t == "semi-bold" or t == "heavy": key.bold = true
+    elif t == "italic" or t == "oblique": key.italic = true
+    else:
+      try: size = parseFloat(tok)
+      except ValueError: family.add t
+  key.family = if family.len == 0: "sans" else: family.join(" ")
+  (key, size)
+
+proc lookupFace(key: FaceKey): Typeface =
+  ## Exact face, else the same family without styles, else any face.
+  if not defaultsLoaded: loadDefaults()
+  for k in [key, FaceKey(family: key.family),
+            FaceKey(family: "sans", bold: key.bold, italic: key.italic),
+            FaceKey(family: "sans")]:
+    if k in faces: return faces[k]
+  for f in faces.values: return f
+  raise newException(ValueError, "rui text (pixie): no font registered; " &
+    "call registerFontFile or set RUI_FONT_FILE")
+
+proc spec(desc: string): FontSpec =
+  let (key, pt) = parseDesc(desc)
+  FontSpec(face: lookupFace(key), px: pt * 96 / 72)
+
+proc newPixieFont(s: FontSpec; color = color(1, 1, 1, 1)): pixie.Font =
+  result = newFont(s.face)
+  result.size = s.px
+  result.paint = color
+
+# ── markup: Pango's common subset ------------------------------------------
+# <b>, <i>, <span foreground='#rrggbb' weight='bold' style='italic'>; entities.
+
+proc unescapeEntities(s: string): string =
+  s.multiReplace(("&lt;", "<"), ("&gt;", ">"), ("&quot;", "\""),
+                 ("&apos;", "'"), ("&amp;", "&"))
+
+proc attrValue(tag, name: string): string =
+  let i = tag.find(name & "=")
+  if i < 0: return ""
+  var j = i + name.len + 1
+  if j >= tag.len: return ""
+  let q = tag[j]
+  if q != '\'' and q != '"': return ""
+  inc j
+  let k = tag.find(q, j)
+  if k < 0: "" else: tag[j ..< k]
+
+proc markupSpans(markup: string; base: FontSpec; desc: string): seq[Span] =
+  ## Spans with their own weight/style/colour; unknown tags are ignored.
+  var bold, italic: seq[bool] = @[false]
+  var colors: seq[pixie.Color] = @[color(0, 0, 0, 1)]
+  let (baseKey, _) = parseDesc(desc)
+  var i = 0
+  var text = ""
+  template flush(acc: var string) =
+    if acc.len > 0:
+      let key = FaceKey(family: baseKey.family, bold: baseKey.bold or bold[^1],
+                        italic: baseKey.italic or italic[^1])
+      let f = newPixieFont(FontSpec(face: lookupFace(key), px: base.px), colors[^1])
+      result.add newSpan(unescapeEntities(acc), f)
+      acc = ""
+  while i < markup.len:
+    if markup[i] == '<':
+      let close = markup.find('>', i)
+      if close < 0: break
+      flush(text)
+      let tag = markup[i + 1 ..< close]
+      if tag.startsWith('/'):
+        if bold.len > 1: (discard bold.pop; discard italic.pop; discard colors.pop)
+      else:
+        bold.add(tag == "b" or attrValue(tag, "weight") == "bold" or bold[^1])
+        italic.add(tag == "i" or attrValue(tag, "style") == "italic" or italic[^1])
+        let fg = attrValue(tag, "foreground")
+        colors.add(if fg.startsWith('#') and fg.len == 7: parseHtmlColor(fg) else: colors[^1])
+      i = close + 1
+    else:
+      text.add markup[i]
+      inc i
+  flush(text)
+
+# ── layout ------------------------------------------------------------------
+
+proc arrange(text, desc: string; wrapWidth: int32; markup: bool): Arrangement =
+  let s = spec(desc)
+  let spans = if markup: markupSpans(text, s, desc)
+              else: @[newSpan(text, newPixieFont(s))]
+  let wrap = wrapWidth > 0
+  typeset(spans, bounds = vec2(if wrap: wrapWidth.float32 else: 0, 0), wrap = wrap)
+
+proc lineHeight(desc: string): float32 =
+  let f = newPixieFont(spec(desc))
+  f.defaultLineHeight
+
+proc baselineOf(desc: string): float32 =
+  ## Distance from the layout's top to the first baseline.
+  let s = spec(desc)
+  s.face.ascent * newPixieFont(s).scale
+
+proc engineMeasure*(text: string, font: string, wrapWidth: int32 = -1,
+                    markup = false, dir = tdAuto): TextMeasure =
+  if text.len == 0:
+    return TextMeasure(width: 0, height: lineHeight(font), baseline: baselineOf(font),
+                       lineCount: 1)
+  let a = arrange(text, font, wrapWidth, markup)
+  let b = a.layoutBounds()
+  let lines = max(1, a.lines.len)
+  TextMeasure(width: b.x, height: max(b.y, float32(lines) * lineHeight(font)),
+              baseline: baselineOf(font), lineCount: lines)
+
+# ── clusters, carets, hit tests ---------------------------------------------
+
+proc isClusterContinuation(r, prev: Rune): bool =
+  ## Codepoints that belong to the cluster before them (no caret before them).
+  let c = int(r)
+  r.isCombining or c == 0x200D or int(prev) == 0x200D or
+    c in 0xFE00 .. 0xFE0F or c in 0x1F3FB .. 0x1F3FF or c in 0xE0020 .. 0xE007F
+
+proc isWordRune(r: Rune): bool = r.isAlpha or (int(r) < 128 and char(int(r)) in Digits)
+
+proc engineClusterAttrs*(text: string; attrs: var CharAttrs) =
+  var runes = toRunes(text)
+  var regionalRun = 0
+  for k in 0 ..< runes.len:
+    let r = runes[k]
+    let prev = if k > 0: runes[k - 1] else: Rune(0)
+    var stop = k == 0 or not isClusterContinuation(r, prev)
+    if int(r) in 0x1F1E6 .. 0x1F1FF:            # flags: pairs of regional indicators
+      if regionalRun mod 2 == 1: stop = false
+      inc regionalRun
+    else: regionalRun = 0
+    attrs.cursorStop[k] = stop
+    attrs.backspaceChar[k] = r.isCombining
+    let w = isWordRune(r)
+    let pw = k > 0 and isWordRune(prev)
+    attrs.wordStart[k] = w and not pw
+    attrs.wordEnd[k] = pw and not w
+  attrs.cursorStop[runes.len] = true
+  attrs.wordEnd[runes.len] = runes.len > 0 and isWordRune(runes[^1])
+
+proc engineMoveCaretVisually*(text: string, index: int, direction: int): Option[int] =
+  ## Logical order (no bidi in this engine): the neighbouring caret stop.
+  var attrs = CharAttrs(byteAt: codepointOffsets(text))
+  let n = attrs.byteAt.len
+  attrs.cursorStop = newSeq[bool](n); attrs.backspaceChar = newSeq[bool](n)
+  attrs.wordStart = newSeq[bool](n); attrs.wordEnd = newSeq[bool](n)
+  engineClusterAttrs(text, attrs)
+  var k = attrs.byteAt.find(index)
+  if k < 0: return none(int)
+  while true:
+    k += (if direction < 0: -1 else: 1)
+    if k < 0 or k >= n: return none(int)
+    if attrs.cursorStop[k]: return some(attrs.byteAt[k])
+
+proc engineSoftBreaks*(text, font: string, wrapWidth: int32): seq[int] =
+  let a = arrange(text, font, wrapWidth, false)
+  let offsets = codepointOffsets(text)
+  result = @[0]
+  for i in 1 ..< a.lines.len:
+    result.add offsets[a.lines[i][0]]
+
+proc runeIndexOf(text: string; byteIndex: int): int =
+  let offsets = codepointOffsets(text)
+  for k, b in offsets:
+    if b >= byteIndex: return k
+  offsets.len - 1
+
+proc engineCursorPosition*(text, font: string, byteIndex: int,
+                           wrapWidth: int32, dir: TextDir): CursorPos =
+  let h = lineHeight(font)
+  if text.len == 0: return CursorPos(x: 0, y: 0, height: h)
+  let a = arrange(text, font, wrapWidth, false)
+  let k = runeIndexOf(text, byteIndex)
+  if k < a.selectionRects.len:
+    let r = a.selectionRects[k]
+    CursorPos(x: r.x, y: r.y, height: max(r.h, h))
+  else:
+    let r = a.selectionRects[^1]
+    CursorPos(x: r.x + r.w, y: r.y, height: max(r.h, h))
+
+proc engineIndexFromPosition*(text, font: string, x, y: float32,
+                              wrapWidth: int32, dir: TextDir): HitResult =
+  if text.len == 0: return HitResult(index: 0, inside: false)
+  let a = arrange(text, font, wrapWidth, false)
+  let offsets = codepointOffsets(text)
+  var best = -1
+  var bestDist = float32.high
+  for k, r in a.selectionRects:
+    let inRow = y >= r.y and y < r.y + r.h
+    if inRow and x >= r.x and x < r.x + r.w:
+      return HitResult(index: offsets[k], trailing: (if x >= r.x + r.w / 2: 1 else: 0),
+                       inside: true)
+    let dy = if y < r.y: r.y - y elif y >= r.y + r.h: y - (r.y + r.h) else: 0'f32
+    let dx = if x < r.x: r.x - x elif x >= r.x + r.w: x - (r.x + r.w) else: 0'f32
+    let d = dy * 1000 + dx                       # same row first, then nearest x
+    if d < bestDist: (bestDist = d; best = k)
+  let r = a.selectionRects[best]
+  HitResult(index: offsets[best], trailing: (if x >= r.x + r.w / 2: 1 else: 0),
+            inside: false)
+
+proc engineParagraphDir*(text: string): TextDir =
+  ## The first strong character's direction (left to right when there is none).
+  for r in text.runes:
+    let c = int(r)
+    if c in 0x0590 .. 0x08FF or c in 0xFB1D .. 0xFDFF or c in 0xFE70 .. 0xFEFF:
+      return tdRtl
+    if r.isAlpha: return tdLtr
+  tdLtr
+
+# ── rasterisation -----------------------------------------------------------
+
+proc render(text, font: string; wrapWidth: int32; m: TextMeasure;
+            markup: bool): pixie.Image =
+  let w = max(1, m.width.int)
+  let h = max(1, m.height.int)
+  result = newImage(w, h)
+  result.fillText(arrange(text, font, wrapWidth, markup))
+
+proc engineRasteriseA8*(text, font: string, wrapWidth: int32,
+                        m: TextMeasure, dir = tdAuto): seq[raylib.Color] =
+  ## Coverage as white RGBA; colour comes from the draw tint.
+  let img = render(text, font, wrapWidth, m, false)
+  result = newSeq[raylib.Color](img.width * img.height)
+  for i, px in img.data:
+    result[i] = raylib.Color(r: 255, g: 255, b: 255, a: px.a)
+
+proc engineRasteriseArgb32*(markupText, font: string, wrapWidth: int32,
+                            m: TextMeasure): seq[raylib.Color] =
+  ## Full colour for markup; Pixie stores premultiplied alpha: undo it.
+  let img = render(markupText, font, wrapWidth, m, true)
+  result = newSeq[raylib.Color](img.width * img.height)
+  for i, px in img.data:
+    let a = px.a
+    if a == 0: continue
+    let un = proc(c: uint8): uint8 = uint8(min(255, c.int * 255 div a.int))
+    result[i] = raylib.Color(r: un(px.r), g: un(px.g), b: un(px.b), a: a)
